# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Adjuster review view (http://localhost:8000/#/adjuster). Leave empty to disable it.
CLAIMVOICE_ADJUSTER_PASSCODE=choose-a-passcode

# Optional: Turso hosted database (see docs/00-PRD.md, decision D7)
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Hosted database (PRD D9): paste the Neon connection string. Leave unset to use local SQLite.
# CLAIMVOICE_DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
